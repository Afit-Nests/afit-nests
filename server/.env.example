DATABASE_URL=postgres://afit_nests_app:replace_me@localhost:5432/afit_nests
DATABASE_SSL=false
DB_POOL_MAX=10
# Generate each with: openssl rand -hex 32   (these placeholders are REJECTED at boot)
JWT_SECRET=GENERATE_ME_openssl_rand_hex_32
COOKIE_SECRET=GENERATE_ME_openssl_rand_hex_32
TOTP_SECRET_ENCRYPTION_KEY=GENERATE_ME_openssl_rand_hex_32
CLIENT_ORIGIN=http://localhost:5173
PORT=4000
PAYSTACK_PUBLIC_KEY=replace_with_paystack_public_key
PAYSTACK_SECRET_KEY=replace_with_paystack_secret_key
REQUIRE_ADMIN_MFA=true
RESET_ADMIN_MFA=false
DISABLE_BREACHED_PASSWORD_CHECK=false
ALLOW_DEV_RESET_URL=false
ALLOW_LOCAL_UPLOADS=false
ALLOW_SEED_ACCESS_USERS=false
PAYSTACK_AUTO_REFUNDS=false
RESEND_API_KEY=replace_with_resend_api_key
MAIL_FROM=AFIT Nests <no-reply@example.com>
CLOUDINARY_CLOUD_NAME=replace_with_cloudinary_cloud_name
CLOUDINARY_API_KEY=replace_with_cloudinary_api_key
CLOUDINARY_API_SECRET=replace_with_cloudinary_api_secret
# Google OAuth (server-side authorization code flow with PKCE).
# 1. In Google Cloud Console → APIs & Services → Credentials, create an OAuth
#    2.0 Client ID of type "Web application".
# 2. Add these Authorized redirect URIs (must match exactly, including the
#    path — Google rejects mismatches):
#      http://localhost:4000/api/auth/google/callback        (local dev)
#      https://api.your-domain.example/api/auth/google/callback  (prod)
# 3. Add these Authorized JavaScript origins (the SPA origin):
#      http://localhost:5173
#      https://your-domain.example
# 4. Copy both the client id and the client secret into this env file.
# Leave either blank to disable Google sign-in entirely; the "Continue with
# Google" buttons on the client surface a clear configuration error in that
# case.
# Set ALLOW_GOOGLE_SIGNUP=true to allow brand-new student accounts to be
# created via Google. Keep it false in production until you are ready to
# accept passwordless signups; existing users can still link their email.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ALLOW_GOOGLE_SIGNUP=false
