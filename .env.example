VITE_PAYSTACK_PUBLIC_KEY=pk_test_replace_with_your_public_key

# API base URL (inlined into the bundle at build time — a change needs a rebuild).
#
# Local dev: the backend runs on its own port, so point at it directly.
VITE_API_BASE_URL=http://localhost:4000/api
#
# PRODUCTION: use the same-origin path `/api`, or leave this unset entirely
# (production builds already fall back to `/api`). The SPA host rewrites
# /api/* to the backend — see `vercel.json` — which keeps the session cookie
# first-party on the SPA's own domain.
#
# Do NOT set this to the backend's absolute URL (e.g.
# https://afit-nests.onrender.com/api). The SPA host and the backend host are
# different sites, so every API call becomes cross-site and the session cookie
# becomes a third-party cookie, which browsers drop by default. The symptom is
# users appearing signed out immediately after signing in. Google OAuth breaks
# first and most visibly: its redirect makes the SPA boot cold, so it must read
# the session from /auth/me alone with no in-memory user to mask the problem.
# Raising SameSite to None does not fix this — see server/src/auth.js.
