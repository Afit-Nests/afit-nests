{
  "name": "afit-nests",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || exit 0",
    "dev": "vite --configLoader runner",
    "backend": "node server/src/index.js",
    "server": "node server/src/index.js",
    "create-admin": "node server/src/scripts/create-admin.js",
    "create-access-users": "node server/src/scripts/create-access-users.js",
    "enroll-admin-mfa": "node server/src/scripts/enroll-admin-mfa.js",
    "migrate": "node server/src/scripts/run-migrations.js",
    "build": "vite build --configLoader runner && node scripts/inject-csp-origin.mjs",
    "test": "node --test \"server/src/**/*.test.js\"",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "engines": {
    "node": ">=20 <25"
  },
  "dependencies": {
    "bcryptjs": "3.0.3",
    "cookie-parser": "1.4.7",
    "cors": "2.8.6",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "express-rate-limit": "8.5.2",
    "helmet": "8.2.0",
    "jsonwebtoken": "9.0.3",
    "leaflet": "1.9.4",
    "lucide-react": "1.23.0",
    "pg": "8.22.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-hot-toast": "2.6.0",
    "react-leaflet": "4.2.1",
    "react-router-dom": "7.18.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "9.39.3",
    "@types/react": "18.3.28",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "autoprefixer": "10.4.27",
    "eslint": "9.39.3",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.26",
    "globals": "15.15.0",
    "postcss": "8.5.16",
    "sharp": "0.34.5",
    "tailwindcss": "3.4.19",
    "vite": "6.4.3",
    "vite-plugin-pwa": "1.2.0"
  }
}
