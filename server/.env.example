DATABASE_URL=postgres://afit_nests_app:***@localhost:5432/afit_nests
# Set to "true" whenever DATABASE_URL points to a hosted Postgres that
# requires TLS (Render Postgres, Neon, Supabase, RDS, etc.). Local
# development databases usually leave this off. The pool also
# auto-enables SSL when the connection string contains `sslmode=require`,
# so this flag is mainly belt-and-braces for operators who paste a
# non-sslmode URL.
DATABASE_SSL=false
DB_POOL_MAX=10
# Generate each with: openssl rand -hex 32   (these placeholders are REJECTED at boot)
JWT_SECRET=GENERATE_ME_openssl_rand_hex_32
COOKIE_SECRET=GENERATE_ME_openssl_rand_hex_32
TOTP_SECRET_ENCRYPTION_KEY=GENERATE_ME_openssl_rand_hex_32
# The SPA's origin. In production this MUST be the Vercel URL (e.g.
# https://afit-nests.vercel.app) so that:
#   1. CORS allows the SPA to call the API
#   2. Post-OAuth redirects land on the SPA, not the backend
#   3. When VITE_API_BASE_URL is NOT set (same-origin via Vercel proxy),
#      the Google callback redirect_uri is built from the request host
#      (which Vercel forwards via X-Forwarded-Host), so cookies are
#      set on the SPA's domain.
# In dev, use http://localhost:5173 (the Vite dev server).
CLIENT_ORIGIN=http://localhost:5173
PORT=4000
PAYSTACK_PUBLIC_KEY=replace_with_paystack_public_key
PAYSTACK_SECRET_KEY=replace_with_paystack_secret_key
REQUIRE_ADMIN_MFA=true
RESET_ADMIN_MFA=false
DISABLE_BREACHED_PASSWORD_CHECK=false
ALLOW_DEV_RESET_URL=false
ALLOW_LOCAL_UPLOADS=false
ALLOW_SEED_ACCESS_USERS=false
PAYSTACK_AUTO_REFUNDS=false
RESEND_API_KEY=replace_with_resend_api_key
MAIL_FROM=AFIT Nests <no-reply@example.com>
CLOUDINARY_CLOUD_NAME=replace_with_cloudinary_cloud_name
CLOUDINARY_API_KEY=replace_with_cloudinary_api_key
CLOUDINARY_API_SECRET=replace_with_cloudinary_api_secret
# Google OAuth (server-side authorization code flow with PKCE).
# 1. In Google Cloud Console → APIs & Services → Credentials, create an OAuth
#    2.0 Client ID of type "Web application".
# 2. Add these Authorized redirect URIs (must match exactly, including the
#    path — Google rejects mismatches). The backend builds the redirect_uri
#    from the request host (respecting X-Forwarded-Host from Vercel's proxy),
#    so the URI depends on how the OAuth flow is initiated:
#    - If VITE_API_BASE_URL is NOT set (SPA uses /api via Vercel proxy):
#      http://localhost:4000/api/auth/google/callback        (local dev)
#      https://afit-nests.vercel.app/api/auth/google/callback  (prod — Vercel forwards X-Forwarded-Host)
#    - If VITE_API_BASE_URL is set to the backend URL (cross-origin):
#      https://afit-nests.onrender.com/api/auth/google/callback  (prod — callback goes directly to backend)
#    Register BOTH production URIs if you switch between setups.
# 3. Add these Authorized JavaScript origins (the SPA origin):
#      http://localhost:5173
#      https://afit-nests.vercel.app
# 4. Copy both the client id and the client secret into this env file.
# Leave either blank to disable Google sign-in entirely; the "Continue with
# Google" buttons on the client surface a clear configuration error in that
# case.
# Set ALLOW_GOOGLE_SIGNUP=true to allow brand-new student accounts to be
# created via Google. Keep it false in production until you are ready to
# accept passwordless signups; existing users can still link their email.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ALLOW_GOOGLE_SIGNUP=false
